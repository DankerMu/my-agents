{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit|Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/instruction-guard/instruction-guard.sh\" --platform claude",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
