{
  "schemaVersion": 1,
  "name": "handoff",
  "displayName": "Handoff",
  "description": "把当前会话压缩成一份交接文档（handoff.md），让新会话或另一个 agent 无缝接续工作。 只在有东西要随身带走时用：换 harness/换目录/交给同事、把中途发现的 side task 分叉出去、issue 工作流跨会话续跑；同会话同目录的阶段过渡走原生压缩，不用它。 手动调用（/handoff），可带参数说明下个会话的重点。模型不会自动触发。",
  "version": "0.2.0",
  "maturity": "experimental",
  "categories": ["productivity", "workflow"],
  "tags": ["handoff", "cross-session", "context-transfer", "continuation", "user-invoked"],
  "authors": [
    {
      "name": "danker"
    }
  ],
  "license": "MIT",
  "entrypoints": {
    "skillDoc": "SKILL.md",
    "changelog": "CHANGELOG.md"
  },
  "capabilities": {
    "shell": true,
    "filesystemRead": true,
    "filesystemWrite": true
  }
}
